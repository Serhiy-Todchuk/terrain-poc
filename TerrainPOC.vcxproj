  <!-- Fail early with a clear message if the dependency build has not been run. -->
  <Target Name="CheckCesiumNative" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CesiumInstallDir)include\Cesium3DTilesSelection\Tileset.h') Or !Exists('$(CesiumLibDir)Cesium3DTilesSelection.lib')"
           Text="Cesium Native is not built for $(Configuration). Run once:  powershell -ExecutionPolicy Bypass -File scripts\build_deps.ps1" />
    <Error Condition="!Exists('$(ImGuiDir)imgui.cpp') Or !Exists('$(ImGuiDir)backends\imgui_impl_dx11.cpp')"
           Text="Dear ImGui sources are missing. Run once:  powershell -ExecutionPolicy Bypass -File scripts\build_deps.ps1 -ImGuiOnly" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)third_party\zlib-ng\zlib-ng.h')"
           Text="The zlib-ng headers are missing. Run once:  powershell -ExecutionPolicy Bypass -File scripts\build_deps.ps1 -ImGuiOnly" />
  </Target>
  <!-- Link every static library produced by the dependency build (Cesium Native
       plus its vcpkg dependencies). Evaluated at build time so the list is
       always current. -->
  <Target Name="AddCesiumNativeLibraries" BeforeTargets="ComputeLinkInputsFromProject">
